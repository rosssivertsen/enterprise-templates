.PHONY: help install dev lint test build run deploy clean

help:  ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'

install:  ## Install dependencies (configure for your project)
	@echo "Configure install command for your project"

dev:  ## Start the development environment (configure for your project)
	@echo "Configure dev command for your project"

lint:  ## Run linters (configure for your language)
	@echo "Configure lint command for your project"

test:  ## Run tests (configure for your language)
	@echo "Configure test command for your project"

build:  ## Build project (configure for your language)
	@echo "Configure build command for your project"

run:  ## Run the application
	@echo "Configure run command for your project"

deploy:  ## Deploy the project (configure for your project)
	@echo "Configure deploy command for your project"

clean:  ## Remove build artifacts
	@echo "Configure clean command for your project"
